# SHIORI Cafe - PostgreSQL application connection
# Copy this file to .env and replace the placeholders.
# Never commit .env or put real credentials in this template.

# These six DB_* values are read by backend/config/db.php.
# For local PostgreSQL, DB_HOST is commonly localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grp10_shioricafedb
DB_SCHEMA=shioricafe_schema

# Use a dedicated PostgreSQL runtime role, not a superuser.
# Both values are required and DB_PASSWORD must be non-empty.
DB_USER=your_runtime_role
DB_PASSWORD=replace_with_a_nonempty_password
