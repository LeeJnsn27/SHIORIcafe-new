# SHIORI Café - example environment variables
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# --- Application ---
APP_ENV=local
APP_URL=http://localhost/SHIORIcafe/
APP_TIMEZONE=Asia/Manila

# --- Database (Neon PostgreSQL) ---
# App runtime: use the POOLED Neon host.
DB_HOST=your-project-pooler.region.aws.neon.tech
DB_PORT=5432
DB_NAME=grp10_shioricafedb
DB_USER=your_db_role
DB_PASSWORD=your_db_password
DB_SSLMODE=require
DB_SCHEMA=shioricafe_schema

# Setup/migrations only: use the DIRECT (non-pooled) connection string.
DATABASE_URL_DIRECT=postgresql://your_db_role:your_db_password@your-project.region.aws.neon.tech/grp10_shioricafedb?sslmode=require

# --- PayMongo (TEST MODE ONLY - never use live keys) ---
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Reminder emails (Google Apps Script -> protected endpoint) ---
# Long random string shared with the Apps Script project.
REMINDER_ENDPOINT_TOKEN=generate_a_long_random_value_here
